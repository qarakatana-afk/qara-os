// Bridge Legacy — Data Model
// Governed by KDR-2026-005, LM2-09 minimal data model requirement.
// Only entities required by M1 + M2 are defined here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A Legacy belongs to exactly one authenticated owner.
// Every owner can have exactly one Legacy (enforced by @unique on ownerId).
model Legacy {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  entries       Entry[]
  signals       Signal[]
}

// A Conversation is a session of guided exploration.
// Status: active | paused | ended
model Conversation {
  id       String   @id @default(cuid())
  legacyId String
  ownerId  String
  status   String   @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  legacy  Legacy  @relation(fields: [legacyId], references: [id], onDelete: Cascade)
  entries Entry[]
}

// An Entry is a single turn in the conversation.
// role: "owner" (what the owner typed) | "ai" (follow-up question generated by AI)
model Entry {
  id           String   @id @default(cuid())
  sessionId    String?
  legacyId     String
  ownerId      String
  role         String   // "owner" | "ai"
  content      String
  createdAt    DateTime @default(now())

  legacy       Legacy        @relation(fields: [legacyId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  signals      Signal[]
}

// A Signal is a structured observation derived from an Entry.
// provenance: "explicit" (owner stated it directly) | "inferred" (AI-derived interpretation)
// Signals are always traceable to the source Entry that generated them.
model Signal {
  id            String   @id @default(cuid())
  legacyId      String
  sourceEntryId String
  category      String   // Person, Place, Passion, Recipe/Food, Skill, Tradition, Memory,
                         // Life Period, Relationship, Accomplishment, Lesson/Wisdom,
                         // Value/Belief, Favorite, Goal/Dream
  value         String
  provenance    String   // "explicit" | "inferred"
  createdAt     DateTime @default(now())

  legacy      Legacy @relation(fields: [legacyId], references: [id], onDelete: Cascade)
  sourceEntry Entry  @relation(fields: [sourceEntryId], references: [id], onDelete: Cascade)
}
