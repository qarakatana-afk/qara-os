# Bridge Legacy — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to source control.

# Clerk authentication (https://clerk.com)
# Create a Clerk application and copy the keys from the dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect paths (leave as-is for default routing)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/legacy
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/legacy

# Database (SQLite for controlled development)
# For local development, use the default SQLite path below.
# For production, replace with a PostgreSQL connection string.
DATABASE_URL="file:./dev.db"

# OpenAI API (https://platform.openai.com)
# Used server-side only — never sent to the client.
OPENAI_API_KEY=sk-...

# Optional: model override (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Stripe (https://dashboard.stripe.com/apikeys)
# Used to unlock full viewing + download of a compiled piece. One-time
# payment, no subscriptions.
STRIPE_SECRET_KEY=sk_test_...
# From Stripe Dashboard > Developers > Webhooks, after adding an endpoint
# pointing at https://<your-domain>/api/stripe/webhook (event:
# checkout.session.completed). Locally, `stripe listen` prints one instead.
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: unlock price in cents (defaults to 2900 = $29.00)
# STRIPE_UNLOCK_PRICE_CENTS=2900
